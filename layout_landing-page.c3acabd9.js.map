        this.isOpen = true;
        // Фокус на кнопку закриття для доступності
        setTimeout(()=>{
            if (this.menuClose) this.menuClose.focus();
        }, 300);
    }
    /**
   * Закриття меню
   */ close() {
        this.menu.classList.remove('menu--open');
        this.menuToggle.setAttribute('aria-expanded', 'false');
